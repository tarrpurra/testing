type EntitlementStatus = variant { Used; Active; Expired };
type Feedback = record {
  id : nat64;
  user_principal : principal;
  is_approved : bool;
  suggestions : text;
  name : text;
  will_return : bool;
  likes : text;
  timestamp : nat64;
  dislikes : text;
};
type HttpHeader = record { value : text; name : text };
type HttpResponse = record {
  status : nat;
  body : blob;
  headers : vec HttpHeader;
};
type InitArgs = record {
  admin : opt principal;
  logo : opt text;
  name : opt text;
  description : opt text;
  symbol : opt text;
};
type LeaderboardEntry = record {
  meme_id : nat64;
  votes : MemeVotes;
  rank : nat32;
  meme_data : opt PublicStoredMeme;
};
type LegacyTopEntry = record {
  upvotes : nat32;
  last_vote_time : nat64;
  meme_id : nat64;
  score : float64;
  downvotes : nat32;
};
type LegacyWeeklyLeaderboard = record {
  week_id : nat64;
  period : WeeklyPeriod;
  top_memes : vec LeaderboardEntry;
  is_active : bool;
};
type ListingStrategy = variant {
  Auction : record { start_price_e8s : nat64 };
  FixedPrice : record { price_e8s : nat64 };
};
type ListingType = variant { None; Auction; FixedPrice };
type MemeCard = record {
  id : nat64;
  creator : principal;
  image_cid : text;
  caption : text;
};
type MemeData = record {
  image_url : text;
  metadata : PythonMetadata;
  name : opt text;
  image_format : text;
  caption : opt text;
  prompt : text;
  image_filename : text;
};
type MemeVotes = record {
  upvotes : nat32;
  last_vote_time : nat64;
  meme_id : nat64;
  score : float64;
  total_voters : nat32;
  downvotes : nat32;
  created_week : nat64;
};
type MetadataValue = variant {
  Map : vec record { text; MetadataValue };
  Blob : blob;
  Text : text;
  Array : vec MetadataValue;
};
type MintEntitlement = record {
  status : EntitlementStatus;
  meme_id : nat64;
  week_id : nat64;
  owner : principal;
  rank : nat8;
  used_at : opt nat64;
  created_at : nat64;
  minted_token_ids : vec nat;
  entitlement_id : nat64;
  expires_at : nat64;
  meme_title : text;
};
type MintingMode = variant { Collection : record { editions : nat32 }; Single };
type NftImage = record { mime_type : text; image : blob };
type PublicStoredMeme = record {
  id : nat64;
  sale_metadata : opt TokenSaleMetadata;
  views : nat64;
  owner : principal;
  created_at : nat64;
  meme_data : MemeData;
  finalized : bool;
  canister_timestamp : nat64;
  week_ended : bool;
  finalized_at : opt nat64;
};
type PythonMetadata = record {
  "service" : text;
  processing_time : float64;
  timestamp : nat64;
  file_size_bytes : nat64;
};
type Result = variant { Ok : text; Err : text };
type Result_1 = variant { Ok : nat32; Err : text };
type Result_2 = variant { Ok; Err : text };
type Result_3 = variant { Ok : vec LegacyTopEntry; Err : text };
type Result_4 = variant { Ok : vec nat; Err : text };
type Result_5 = variant { Ok : PublicStoredMeme; Err : text };
type Result_6 = variant { Ok : VoteResponse; Err : text };
type SupportedStandard = record { url : text; name : text };
type TokenMetadataEntry = record {
  value : MetadataValue;
  name : text;
  immutable : bool;
};
type TokenRecord = record {
  meme_id : nat64;
  token_id : nat;
  owner : principal;
  metadata : vec TokenMetadataEntry;
  mime_type : opt text;
  has_image : bool;
  minted_at : nat64;
};
type TokenSaleMetadata = record {
  listing_price : opt nat64;
  total_sales : nat64;
  auction_highest_bidder : opt principal;
  auction_bid_count : nat32;
  listing_type : ListingType;
  meme_id : nat64;
  auction_start_price : opt nat64;
  token_id : nat;
  last_sale_price : opt nat64;
  is_listed : bool;
  last_sale_at : opt nat64;
  total_earned : nat64;
  auction_highest_bid : opt nat64;
  listed_at : opt nat64;
};
type TopEntry = record { meme_id : nat64; votes : nat64; rank : nat32 };
type TopLikedLeaderboard = record {
  total_ranked : nat32;
  top_memes : vec LeaderboardEntry;
};
type TransformArgs = record { context : blob; response : HttpResponse };
type UserPower = record { cap : nat32; week_id : nat64; remaining : nat32 };
type UserProfile = record {
  updated_at : nat64;
  "principal" : principal;
  username : opt text;
  created_at : nat64;
  display_name : opt text;
};
type VoteRecord = record { vote_type : VoteType; timestamp : nat64 };
type VoteResponse = record {
  new_vote_count : nat32;
  message : text;
  success : bool;
  user_previous_vote : opt VoteType;
};
type VoteType = variant { Downvote; Upvote };
type WeeklyLeaderboard = record {
  top : vec TopEntry;
  week_id : nat64;
  finalized_at : nat64;
};
type WeeklyPeriod = record {
  meme_count : nat32;
  week_id : nat64;
  end_time : nat64;
  is_completed : bool;
  start_time : nat64;
};
type WinnerNotice = record {
  status : EntitlementStatus;
  issued_at : nat64;
  meme_id : nat64;
  week_id : nat64;
  rank : nat8;
  used_at : opt nat64;
  message : text;
  entitlement_id : nat64;
  expires_at : nat64;
  meme_title : text;
};
service : (opt InitArgs) -> {
  admin_rollover_now : () -> (opt nat64);
  admin_set_week_offset : (int64) -> ();
  // Approve feedback for public display (admin function)
  approve_feedback : (nat64) -> (Result);
  check_remaining_calls : () -> (nat8) query;
  // Clear all memes from HTTP outcall storage (admin function)
  clear_all_memes : () -> (Result_1);
  // Mark any past weeks complete if their end_time has passed
  close_finished_weeks : () -> ();
  create_meme : (text, text) -> (nat64);
  // Delete all memes in the system (admin function, deletes all memes regardless of ownership, except minted NFTs)
  delete_all_user_memes : () -> (Result_1);
  // Delete feedback (admin function)
  delete_feedback : (nat64) -> (Result);
  // Delete a meme (owner only, if not minted as NFT)
  delete_meme : (nat64) -> (Result_2);
  // Manually finalize any weeks that have ended.
  // Useful to ensure `is_completed = true` even if no votes happen at boundary.
  finalize_finished_weeks : () -> (text);
  // Force-complete a specific week_id (admin/ops hook).
  finalize_week : (nat64) -> (Result_2);
  // Force finalize current week for testing (admin function)
  force_finalize_current_week : () -> (Result);
  generate_meme : (text) -> (Result);
  get_active_week : () -> (nat64) query;
  get_admin : () -> (principal) query;
  // Get all feedback (admin function)
  get_all_feedback : () -> (vec Feedback) query;
  // List all memes for marketplace (newest first)
  get_all_memes : () -> (vec PublicStoredMeme) query;
  get_all_minted_tokens : () -> (vec TokenRecord) query;
  // Get all approved feedback for public display
  get_approved_feedback : (opt nat32) -> (vec Feedback) query;
  // Completed weeks
  get_completed_weeks : () -> (vec WeeklyPeriod) query;
  get_current_leaderboard : (nat32, nat32) -> (vec TopEntry) query;
  // Legacy leaderboard query kept for backwards compatibility.
  get_current_leaderboard_legacy : (opt nat32) -> (
      LegacyWeeklyLeaderboard,
    ) query;
  get_current_week_meme_count : () -> (nat64) query;
  // Status for current week
  get_current_week_status : () -> (nat64, nat64, nat64, bool) query;
  get_entitlements_for_meme : (nat64) -> (vec MintEntitlement) query;
  // Get feedback statistics
  get_feedback_stats : () -> (nat32, nat32, float64) query;
  get_leaderboard_by_week : (nat64) -> (opt WeeklyLeaderboard) query;
  get_lifetime_votes : () -> (nat64) query;
  // Get only memes that are listed for sale on the marketplace
  get_marketplace_memes : () -> (vec PublicStoredMeme) query;
  get_meme : (nat64) -> (opt PublicStoredMeme) query;
  // Get per-meme votes
  get_meme_votes : (nat64) -> (opt MemeVotes) query;
  get_my_mint_entitlements : () -> (vec MintEntitlement) query;
  get_my_minted_tokens : () -> (vec TokenRecord) query;
  get_my_winner_notices : () -> (vec WinnerNotice) query;
  get_nft_image : (nat) -> (opt NftImage) query;
  // Get the previous week ID for filtering purposes
  get_previous_week_id : () -> (opt nat64) query;
  get_sale_metadata : (nat) -> (opt TokenSaleMetadata) query;
  get_sale_metadata_for_meme : (nat64) -> (opt TokenSaleMetadata) query;
  get_token : (nat) -> (opt TokenRecord) query;
  get_token_by_meme_id : (nat64) -> (opt nat) query;
  get_tokens_by_meme_id : (nat64) -> (vec nat) query;
  // Return **Top 3** for a given week (for NFT mint step).
  // Fails if the week is not completed yet.
  get_top3_for_week : (nat64) -> (Result_3) query;
  // Global leaderboard based on most upvotes across all weeks.
  get_top_liked_memes : (opt nat32) -> (TopLikedLeaderboard) query;
  get_total_memes : () -> (nat64) query;
  get_total_users : () -> (nat64) query;
  get_user_meme_count : () -> (nat32) query;
  get_user_memes : () -> (vec PublicStoredMeme) query;
  get_user_profile : () -> (opt UserProfile) query;
  get_user_profile_by_principal : (principal) -> (opt UserProfile) query;
  // Did caller vote on meme?
  get_user_vote : (nat64) -> (opt VoteRecord) query;
  // Get the authenticated user's current weekly voting power
  get_voting_power : () -> (UserPower) query;
  // Leaderboard for any week id. Returns None if week not found.
  get_week_leaderboard : (nat64, opt nat32) -> (
      opt LegacyWeeklyLeaderboard,
    ) query;
  get_week_offset : () -> (int64) query;
  health : () -> (text) query;
  icrc7_name : () -> (text) query;
  icrc7_owner_of : (vec nat) -> (vec opt principal) query;
  icrc7_supported_standards : () -> (vec SupportedStandard) query;
  icrc7_symbol : () -> (text) query;
  icrc7_tokens_of : (principal) -> (vec nat) query;
  icrc7_total_supply : () -> (nat) query;
  // Increment view count for a meme
  increment_meme_views : (nat64) -> (Result_2);
  // Check if a meme has been minted as an NFT
  is_meme_minted : (nat64) -> (bool) query;
  list_finalized_weeks : (nat32, nat32) -> (vec nat64) query;
  // List a meme for sale on the marketplace
  list_meme_for_sale : (nat64, ListingStrategy) -> (Result_2);
  list_memes_by_flag : (bool, nat32, nat32) -> (vec MemeCard) query;
  list_premarket_memes : (nat32, nat32) -> (vec MemeCard) query;
  mint_to : (nat64, MintingMode) -> (Result_4);
  // Store a generated meme into marketplace (associated to caller)
  publish_meme : (MemeData) -> (Result_5);
  // Record a sale (called internally or by marketplace canister)
  record_meme_sale : (nat64, nat64) -> (Result_2);
  // Remove all memes from the marketplace (admin function)
  remove_all_memes_from_market : () -> (Result_1);
  // Remove a meme from the marketplace
  remove_meme_from_market : (nat64) -> (Result_2);
  // Remove your vote (works only for current active week)
  remove_vote : (nat64) -> (Result_6);
  // Comprehensive system reset - clears all data and resets to week 1
  // WARNING: This will delete ALL memes, votes, leaderboards, and reset the system
  reset_system_to_week_1 : () -> (Result);
  // Submit feedback from a user
  submit_feedback : (text, text, text, text, bool) -> (Result);
  // Maintenance function to ensure week state is always synchronized
  // This can be called periodically to handle edge cases and ensure consistency
  sync_week_state : () -> (text);
  transform : (TransformArgs) -> (HttpResponse) query;
  update_user_profile : (opt text, opt text) -> (Result_2);
  vote : (nat64, bool) -> (Result_2);
  vote_meme : (nat64, VoteType) -> (Result_6);
  vote_with_power : (nat64, VoteType, nat32) -> (Result_6);
  whoami : () -> (principal) query;
}
